# Copy this file to .env and fill in your own values. Never commit .env.

# Which issue tracker to fetch from: "github" (default) or "jira"
ISSUE_TRACKER=github

# --- GitHub settings (used when ISSUE_TRACKER=github) ---

# A GitHub personal access token with `repo` (read) scope, or the default
# GITHUB_TOKEN provided automatically inside GitHub Actions.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Repo to report on, format "owner/repo"
GITHUB_REPO=your-org/your-repo

# --- Jira Cloud settings (used when ISSUE_TRACKER=jira) ---

# Base URL of your Jira Cloud site
JIRA_BASE_URL=https://your-company.atlassian.net

# Atlassian account email used to generate the API token below
JIRA_EMAIL=you@example.com

# Jira API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Project key to scope the query to, e.g. "PROJ"
JIRA_PROJECT_KEY=PROJ

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional overrides (shared by both trackers)
ANTHROPIC_MODEL=claude-sonnet-4-6
ISSUE_STATE=open
ISSUE_LABELS=
LOOKBACK_DAYS=7
